<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d18" />
    <meta name="description" content="Comercializadora de celulares GR09. Catálogo, facturación y crédito BanQuito." />
    <title>Celulares · GR09</title>
    <script>try { document.documentElement.dataset.theme = localStorage.getItem("celulares-tema") || "oscuro"; } catch { document.documentElement.dataset.theme = "oscuro"; }</script>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="app-header">
        <div class="header-left">
            <a class="brand" asp-controller="Tienda" asp-action="Index">
                CELULARES <span class="brand-badge">GR09</span>
            </a>
            <nav class="nav-segmented" aria-label="Navegación principal">
                <a class="nav-tab @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-controller="Tienda" asp-action="Index">
                    <span class="nav-icon" aria-hidden="true">📱</span>
                    <span>Catálogo</span>
                </a>
                <a class="nav-tab @(ViewContext.RouteData.Values["action"]?.ToString() == "Ventas" || ViewContext.RouteData.Values["action"]?.ToString() == "Factura" ? "active" : "")" 
                   asp-controller="Tienda" asp-action="Ventas">
                    <span class="nav-icon" aria-hidden="true">💳</span>
                    <span>Ventas &amp; Facturación</span>
                </a>
            </nav>
        </div>
        <div class="header-actions">
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema visual" aria-pressed="false">
                <span class="theme-icon" aria-hidden="true">🌓</span>
                <span class="theme-label">Tema claro</span>
            </button>
        </div>
    </header>
    <main>@RenderBody()</main>
    <script src="~/js/tema.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
